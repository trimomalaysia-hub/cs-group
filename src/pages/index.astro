---
/* HOME PAGE
   Tip: each <Section> below is one band of the page. Edit the text inside,
   or copy a whole <Section> to add a new band. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CTA from "../components/CTA.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";

const services = [
  { icon: "💻", title: "Software Development", text: "Custom web and mobile apps built for performance, security and scale." },
  { icon: "☁️", title: "Cloud Solutions", text: "Migrate, manage and optimise your infrastructure on modern cloud platforms." },
  { icon: "🤖", title: "AI & Automation", text: "Practical AI and automation that cut busywork and unlock new insights." },
  { icon: "🎨", title: "Product & UX Design", text: "Clean, intuitive interfaces your customers genuinely enjoy using." },
  { icon: "🔒", title: "Security & Support", text: "Proactive monitoring, maintenance and support to keep you running." },
  { icon: "📈", title: "Digital Strategy", text: "Roadmaps and consulting that align technology with your business goals." },
];

const stats = [
  { value: "50+", label: "Projects delivered" },
  { value: "98%", label: "Client satisfaction" },
  { value: "10+", label: "Years of experience" },
  { value: "24/7", label: "Support available" },
];
---

<BaseLayout>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden">
    <!-- soft background gradient -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-50 via-white to-white"></div>
    <div class="pointer-events-none absolute -top-32 right-0 -z-10 h-96 w-96 rounded-full bg-accent-400/20 blur-3xl"></div>

    <div class="mx-auto max-w-6xl px-6 pt-20 pb-24 text-center sm:pt-28 lg:px-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-1.5 text-sm font-medium text-brand-700">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span>
        {site.tagline}
      </span>

      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">
        Smart technology for
        <span class="bg-gradient-to-r from-brand-600 to-accent-500 bg-clip-text text-transparent">growing businesses</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
        {site.name} designs and builds software, cloud and AI solutions that help
        your team work smarter — and your business grow faster.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/contact" size="lg">Start a project</Button>
        <Button href="/services" variant="secondary" size="lg">Explore services</Button>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <Section id="services" muted>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold sm:text-4xl">What we do</h2>
      <p class="mt-4 text-muted">
        End-to-end technology services, from first idea to ongoing support.
      </p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <FeatureCard title={s.title} icon={s.icon}>{s.text}</FeatureCard>
      ))}
    </div>
  </Section>

  <!-- ===================== STATS ===================== -->
  <Section>
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center">
          <div class="font-display text-4xl font-bold text-brand-600 sm:text-5xl">{s.value}</div>
          <div class="mt-2 text-sm text-muted">{s.label}</div>
        </div>
      ))}
    </div>
  </Section>

  <!-- ===================== CALL TO ACTION ===================== -->
  <CTA />
</BaseLayout>
