---
/* SERVICES PAGE */
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CTA from "../components/CTA.astro";

const services = [
  { icon: "💻", title: "Software Development", text: "Web and mobile applications, internal tools and APIs — built to be fast, secure and easy to maintain." },
  { icon: "☁️", title: "Cloud Solutions", text: "Cloud migration, architecture and DevOps on AWS, Azure or Google Cloud, optimised for cost and reliability." },
  { icon: "🤖", title: "AI & Automation", text: "Chatbots, document processing, data pipelines and workflow automation that save your team real time." },
  { icon: "🎨", title: "Product & UX Design", text: "Research, prototyping and interface design that turns ideas into products people love to use." },
  { icon: "🔒", title: "Security & Support", text: "Security reviews, monitoring, maintenance and responsive support to keep everything running smoothly." },
  { icon: "📈", title: "Digital Strategy", text: "Technology roadmaps, audits and consulting to make confident, well-informed decisions." },
];
---

<BaseLayout title="Services" description="Explore the technology services Nexxatech offers, from software development to AI and support.">
  <Section>
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Our services</p>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Everything you need to build and grow</h1>
      <p class="mt-6 text-lg text-muted">
        Whether you're launching something new or improving what you already have,
        we have the skills to help at every stage.
      </p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <FeatureCard title={s.title} icon={s.icon}>{s.text}</FeatureCard>
      ))}
    </div>
  </Section>

  <CTA title="Not sure where to start?" text="Book a free consultation and we'll help you find the right approach." />
</BaseLayout>
