---
/* Bold "call to action" band — invites visitors to take the next step.
   Used near the bottom of pages. */
import Button from "./Button.astro";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Ready to build something great?",
  text = "Let's talk about your project. We reply within one business day.",
} = Astro.props;
---

<section class="px-6 py-20 lg:px-8">
  <div class="relative mx-auto max-w-5xl overflow-hidden rounded-3xl bg-brand-700 px-8 py-16 text-center sm:px-16">
    <!-- decorative gradient glow -->
    <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-accent-500/30 blur-3xl"></div>
    <div class="relative">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-brand-100">{text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/contact" variant="secondary" size="lg">Get in touch</Button>
        <Button href="/services" variant="ghost" size="lg" class="text-white hover:bg-white/10">See our services →</Button>
      </div>
    </div>
  </div>
</section>
