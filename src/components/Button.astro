---
/* Reusable button / link.
   Usage:
     <Button href="/contact">Get in touch</Button>
     <Button href="/services" variant="secondary">Our services</Button>
     <Button href="#" variant="ghost" size="sm">Learn more</Button>
*/
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: extra = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600";

const variants = {
  primary:
    "bg-brand-600 text-white shadow-sm hover:bg-brand-700 hover:shadow-md active:scale-[0.98]",
  secondary:
    "bg-white text-ink ring-1 ring-slate-200 hover:ring-brand-300 hover:text-brand-700 active:scale-[0.98]",
  ghost:
    "text-brand-700 hover:bg-brand-50 active:scale-[0.98]",
};

const sizes = {
  sm: "text-sm px-4 py-2",
  md: "text-sm px-5 py-2.5",
  lg: "text-base px-7 py-3.5",
};

const cls = `${base} ${variants[variant]} ${sizes[size]} ${extra}`;
const Tag = href ? "a" : "button";
---

<Tag class={cls} href={href} {...rest}>
  <slot />
</Tag>
