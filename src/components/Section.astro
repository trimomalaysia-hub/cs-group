---
/* A page section with consistent spacing + a centered container.
   Keeps every section vertically aligned and the same max width.
   Usage:
     <Section>...content...</Section>
     <Section muted id="services">...content...</Section>
*/
interface Props {
  id?: string;
  muted?: boolean;     // light grey background (good for alternating sections)
  class?: string;
}
const { id, muted = false, class: extra = "" } = Astro.props;
---

<section id={id} class={`py-20 sm:py-28 ${muted ? "bg-subtle" : "bg-surface"} ${extra}`}>
  <div class="mx-auto w-full max-w-6xl px-6 lg:px-8">
    <slot />
  </div>
</section>
