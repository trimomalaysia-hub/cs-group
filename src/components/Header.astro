---
/* Sticky site header with logo + navigation + a call-to-action button.
   Nav links come from src/data/site.ts (edit them there). */
import { site } from "../data/site";
import Button from "./Button.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-ink">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">N</span>
      {site.name}
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-1 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
            isActive(item.href)
              ? "text-brand-700"
              : "text-muted hover:text-ink"
          }`}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <Button href="/contact" size="sm">Get started</Button>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="grid h-10 w-10 place-items-center rounded-lg text-ink md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu (hidden by default) -->
  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-1">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class={`block rounded-lg px-3 py-2.5 text-base font-medium ${
              isActive(item.href) ? "bg-brand-50 text-brand-700" : "text-ink hover:bg-slate-50"
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <Button href="/contact" class="w-full">Get started</Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Toggle the mobile menu open/closed
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });
</script>
